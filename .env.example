# mock | mysql
DATA_SOURCE=mock

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rpa_ops
MYSQL_USER=rpa_ops
MYSQL_PASSWORD=change-me

# InfluxDB 2.x HTTP query adapter. Leave blank to use mock observations.
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_CONNECTIVITY_MEASUREMENT=network_probe
INFLUX_RESOURCE_MEASUREMENT=vm_resource

# External links
NEXT_PUBLIC_GRAFANA_BASE_URL=https://grafana.example.internal

# Standard Telegraf resource adapter (override if your measurement/tag names differ)
INFLUX_HOST_TAG=host
INFLUX_CPU_MEASUREMENT=cpu
INFLUX_MEM_MEASUREMENT=mem
INFLUX_DISK_MEASUREMENT=disk
